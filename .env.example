ANTHROPIC_API_KEY=your-key-here

# SQL Server (Azure SQL) — username/password auth
DATABASE_URL=mssql+pyodbc://username:password@server.database.windows.net:1433/database?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# SQL Server — Azure AD Managed Identity / DefaultAzureCredential (no password)
# DATABASE_URL=mssql+pyodbc://@server.database.windows.net:1433/database?driver=ODBC+Driver+18+for+SQL+Server&Authentication=ActiveDirectoryDefault&Encrypt=yes

# IMPORTANT: the DATABASE_URL above must use a SQL Server login
# with db_datareader only — no db_datawriter, no EXECUTE grants.

# SQL Server — writable login for DevCare CRUD operations
DEVCARE_WRITE_DATABASE_URL=mssql+pyodbc://username:password@server.database.windows.net:1433/DevCare?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# Developer-only gate for the in-chat query-feedback feature (unset = feature off)
CHAT_FEEDBACK_TOKEN=

# HTTP Basic gate for the chat service (unset = ungated, local dev only)
APP_PASSWORD=

# SQL Server — writable login for the ERP database bill ingestion writes to
# (currently DevDB). Writes land in whatever database this URL names.
BILLS_WRITE_DATABASE_URL=mssql+pyodbc://username:password@server.database.windows.net:1433/DevDB?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

# HTTP Basic gate for the DevCare operations service, which writes to the ERP
# database. Its own secret, separate from the other two. Unset = ungated, local
# dev only.
DEVCARE_APP_PASSWORD=

# HTTP Basic gate for the bill-ingestion service. Deliberately a DIFFERENT
# secret from the chat service's APP_PASSWORD: leaking the read-only service
# must not hand over the one that writes. Unset = ungated, local dev only.
BILLS_APP_PASSWORD=

# Admin gate for editing the bills write mapping (unset = feature off, and every
# /admin/rules* route returns 404). A THIRD secret, separate from
# BILLS_APP_PASSWORD: an operator may use the service without being able to
# change how invoices map onto database columns.
BILLS_ADMIN_TOKEN=
